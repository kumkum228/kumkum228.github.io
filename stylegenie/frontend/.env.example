# -----------------------------------------------------------------------------
# StyleGenie Frontend Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to ".env" inside the frontend folder:
#     cp .env.example .env
#
# IMPORTANT: In Vite, only variables that start with VITE_ are exposed to the
# React code. Never put secret keys (like the Gemini key) here — anything in
# the frontend is visible to the browser. Only the backend URL belongs here.
# -----------------------------------------------------------------------------

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api
