# -----------------------------------------------------------------------------
# StyleGenie Backend Environment Variables
# -----------------------------------------------------------------------------
# 1. Copy this file to a new file named ".env" in the same folder:
#        cp .env.example .env      (macOS/Linux)
#        copy .env.example .env    (Windows)
# 2. Fill in the real values below.
# 3. NEVER commit the real .env file. It is already listed in .gitignore.
# -----------------------------------------------------------------------------

# ---- Database -------------------------------------------------------------
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
# Default XAMPP MySQL user is "root" with an empty password.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/stylegenie_db

# ---- Authentication (JWT) -------------------------------------------------
# A long random secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Google Gemini AI -----------------------------------------------------
# Create a free key at https://aistudio.google.com/app/apikey
# This key stays on the BACKEND only. Never put it in the React frontend.
GEMINI_API_KEY=

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173
